@* Image placeholders, as the brief allows. Decorative only, so hidden from assistive technology. *@
@switch (Kind)
{
  case PlaceholderKind.Avatar:
    <svg class="placeholder placeholder--avatar" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
      <circle cx="32" cy="32" r="30" />
      <circle cx="32" cy="25" r="9" />
      <path d="M16 50c2-9 9-13 16-13s14 4 16 13" />
    </svg>
    break;
  case PlaceholderKind.Film:
    <svg class="placeholder placeholder--film" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
      <rect x="4" y="4" width="56" height="56" />
      <circle cx="40" cy="20" r="6" />
      <path d="M4 52l18-20 14 14 8-8 16 14" />
    </svg>
    break;
  default:
    <svg class="placeholder placeholder--craft" viewBox="0 0 70 64" aria-hidden="true" focusable="false">
      <rect x="1" y="1" width="68" height="62" />
      <path d="M1 1l68 62M69 1L1 63" />
    </svg>
    break;
}

@code {
    [Parameter]
    public PlaceholderKind Kind { get; set; }
}
